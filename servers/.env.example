# Copy to servers/.env on the VM and fill in.
# This file is a TEMPLATE — never put a real credential in it, it is committed.
#
# Workers refuse to boot without SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
# A supplier with no credentials simply contributes zero offers: refreshPair()
# returns 0 rather than throwing, so one unconfigured supplier never stops the
# others. As of K-phase, an unreachable supplier NEVER falls back to invented
# products — it fetches nothing, and a mapping with nothing cached is not
# routable. Empty is the safe state; fabricated is not.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
API_SECRET=

# --- Zendit (live; currently the only proven top-up supplier) ----------------
ZENDIT_API_SECRET=
# ZENDIT_BASE_URL=https://api.zendit.io/v1

# --- DTOne / DVS ------------------------------------------------------------
# ⚠ The default base URL is the PRE-PRODUCTION host. Prices from it are
# indicative only (supplier_policy carries a 5% risk premium for this reason).
# Every DTOne mapping is deliberately left DISABLED until a production endpoint
# and credentials are in place.
# ⚠ This account settles in OMR, not USD. providers/dtone.js REFUSES to cache a
# non-USD price rather than mislabel it, and fx_rates now carries OMR (pegged,
# 1 OMR = 2.6008 USD) so conversion is possible.
DTONE_API_KEY=
DTONE_API_SECRET=
# DTONE_BASE_URL=https://preprod-dvs-api.dtone.com/v1   # production: https://dvs-api.dtone.com/v1

# --- Ding / DingConnect -----------------------------------------------------
# Sent as the `api_key` REQUEST HEADER, not a bearer token.
# The key value is shown ONCE, at creation, in Account Settings → Developer →
# API Keys. An existing key cannot be re-read — create a new one and copy it
# immediately.
# ⚠ Also check, on that same page: IP Whitelisting must either be off or include
# the VM's public IP, and Account Settings → Allowed Countries must include the
# countries you intend to sell.
DING_API_KEY=
# DING_BASE_URL=https://api.dingconnect.com/api/V1

# --- Reloadly ---------------------------------------------------------------
# OAuth client-credentials, NOT a static key. Get the pair from the Reloadly
# dashboard under Developers → API Settings.
# ⚠ The token's `audience` must match the host you then call. RELOADLY_AUDIENCE
# defaults to RELOADLY_BASE_URL so they cannot drift — only set it by hand if
# you know you need to. A mismatch 401s in a way that reads exactly like a bad
# credential, which is how hours get lost.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# RELOADLY_BASE_URL=https://topups.reloadly.com          # sandbox: https://topups-sandbox.reloadly.com
# RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
# RELOADLY_AUDIENCE=            # leave unset; defaults to RELOADLY_BASE_URL

# --- eSIM Access ------------------------------------------------------------
ESIM_ACCESS_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
# ESIM_ACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open

# --- Offers cache tuning ----------------------------------------------------
# OFFERS_CACHE_REFRESH_MS=600000      # full catalogue sweep every 10 minutes
# OFFERS_CACHE_PAIR_DELAY_MS=500      # politeness gap between supplier calls

  "wallet_triggers": [
    {
      "table": "wallets",
      "function": "update_updated_at()",
      "definition": "CREATE TRIGGER trg_wallets_updated_at BEFORE UPDATE ON public.wallets FOR EACH ROW EXECUTE FUNCTION update_updated_at()"
    },
    {
      "table": "wallet_transactions",
      "function": "trg_fn_award_referral_points()",
      "definition": "CREATE TRIGGER trg_award_referral_wallet AFTER INSERT ON public.wallet_transactions FOR EACH ROW WHEN (((new.type = 'plan_fee_debit'::text) AND (new.sim_line_id IS NOT NULL))) EXECUTE FUNCTION trg_fn_award_referral_points()"
    },
    {
      "table": "wallet_transactions",
      "function": "trg_fn_notify_wallet_credit()",
      "definition": "CREATE TRIGGER trg_notify_wallet_credit AFTER INSERT ON public.wallet_transactions FOR EACH ROW WHEN ((new.type = 'deposit'::text)) EXECUTE FUNCTION trg_fn_notify_wallet_credit()"
    },
    {
      "table": "wallet_transactions",
      "function": "trg_fn_resume_awaiting_funds()",
      "definition": "CREATE TRIGGER trg_resume_awaiting_funds AFTER INSERT ON public.wallet_transactions FOR EACH ROW EXECUTE FUNCTION trg_fn_resume_awaiting_funds()"

  "reconciliation": " SELECT w.id AS wallet_id,\n    w.user_id,\n    w.balance,\n    COALESCE(sum(\n        CASE\n            WHEN t.type = ANY (ARRAY['deposit'::text, 'refund'::text, 'referral_credit'::text, 'auto_fund'::text, 'gift_received'::text, 'admin_credit'::text]) THEN t.amount\n            WHEN t.type = ANY (ARRAY['topup_debit'::text, 'welcome_home_debit'::text, 'plan_fee_debit'::text, 'esim_purchase_debit'::text, 'call_debit'::text, 'voucher_purchase_debit'::text, 'gift_sent'::text, 'refund_payout'::text, 'admin_debit'::text]) THEN - t.amount\n            ELSE 0.00\n        END), 0.00) AS ledger_sum,\n    w.balance - COALESCE(sum(\n        CASE\n            WHEN t.type = ANY (ARRAY['deposit'::text, 'refund'::text, 'referral_credit'::text, 'auto_fund'::text, 'gift_received'::text, 'admin_credit'::text]) THEN t.amount\n            WHEN t.type = ANY (ARRAY['topup_debit'::text, 'welcome_home_debit'::text, 'plan_fee_debit'::text, 'esim_purchase_debit'::text, 'call_debit'::text, 'voucher_purchase_debit'::text, 'gift_sent'::text, 'refund_payout'::text, 'admin_debit'::text]) THEN - t.amount\n            ELSE 0.00\n        END), 0.00) AS drift\n   FROM wallets w\n     LEFT JOIN wallet_transactions t ON t.wallet_id = w.id\n  GROUP BY w.id, w.user_id, w.balance;",

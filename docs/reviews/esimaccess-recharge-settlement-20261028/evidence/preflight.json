          "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'completed'::text, 'failed'::text, 'reversed'::text])))"
        },
        {
          "name": "wallet_transactions_type_check",
          "table": "wallet_transactions",
          "definition": "CHECK ((type = ANY (ARRAY['deposit'::text, 'topup_debit'::text, 'refund'::text, 'referral_credit'::text, 'referral_withdrawal'::text, 'plan_fee_debit'::text, 'home_mode_debit'::text, 'auto_fund'::text, 'esim_purchase_debit'::text, 'esim_purchase_refund'::text, 'wallet_settlement'::text, 'wallet_forfeit'::text, 'gift_sent'::text, 'gift_received'::text, 'admin_adjustment'::text, 'offline_voucher_debit'::text, 'call_debit'::text, 'call_refund'::text, 'did_purchase_debit'::text])))"
        },
        {
          "name": "wallet_transactions_user_id_fkey",
          "table": "wallet_transactions",
          "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE SET NULL"
        },
        {
          "name": "wallet_transactions_wallet_id_fkey",
          "table": "wallet_transactions",
          "definition": "FOREIGN KEY (wallet_id) REFERENCES wallets(id) ON DELETE CASCADE"
        },
        {
          "name": "uq_wallet_holds_ref",
          "table": "wallet_holds",
          "definition": "UNIQUE (order_type, order_reference_id)"
        },
        {
          "name": "wallet_holds_amount_check",
          "table": "wallet_holds",
          "definition": "CHECK ((amount > (0)::numeric))"
        },
        {
          "name": "wallet_holds_order_type_check",
          "table": "wallet_holds",
          "definition": "CHECK ((order_type = ANY (ARRAY['refill_instant'::text, 'refill_scheduled'::text, 'setup_refill'::text, 'plan_fee'::text, 'esim_purchase'::text, 'call_budget'::text, 'offline_voucher'::text, 'refund_request'::text, 'line_verification'::text])))"
        },
        {
          "name": "wallet_holds_pkey",

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface: the app's dark background, so the tile reads as KeepSIMs
     on any wallpaper. Corner radius follows the launcher's own on API 31+. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/ks_widget_radius" />
    <solid android:color="#F20D141D" />
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" />
</shape>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match `kIosAppGroupId` in home_widget_publisher.dart and the same
	     group on Runner.entitlements. Without this the extension reads an empty
	     UserDefaults and the widget renders the placeholder forever. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.keep_sims.widget</string>
	</array>
</dict>
</plist>
